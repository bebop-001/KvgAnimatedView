<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:theme="@style/Theme.KanjiAnimator.AppBarOverlay">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/Theme.KanjiAnimator.PopupOverlay" />
        </com.google.android.material.appbar.AppBarLayout>


    <EditText
        android:id="@+id/kanji_select_et"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_bg"
        android:singleLine="true"
        android:textSize="20sp"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:padding="3dp"
        android:gravity="center_horizontal"
        android:hint="@string/select_kanji"
        android:imeOptions="actionSearch"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="Autofill,TextFields" />

    <GridView
        android:id="@+id/animate_select_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/border_bg"
        android:numColumns="7"
        android:padding="3dp"
        android:paddingRight="15dp"
        android:fastScrollAlwaysVisible="true"
        android:scrollbarStyle="outsideInset"
        android:scrollbarSize="5dp"
        android:scrollbarThumbVertical="@color/green"
        android:fadeScrollbars="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/kanji_select_et"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
